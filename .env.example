# Configuração única — usada pelo server (FastAPI) e pelo client (Vite).
# Copie este arquivo como .env na raiz do repositório e preencha
# com as credenciais do seu projeto Supabase.
#
# Client e server usam as mesmas variáveis: a URL do projeto e a chave
# publishable (anon). O server as lê em server/app/config.py e o client
# em client/src/supabaseClient.js (via import.meta.env).

VITE_SUPABASE_URL=sua_url_aqui
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable_aqui
